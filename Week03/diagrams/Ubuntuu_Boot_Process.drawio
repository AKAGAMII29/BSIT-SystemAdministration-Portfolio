<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/28.1.2 Chrome/138.0.7204.243 Electron/37.4.0 Safari/537.36" version="28.1.2">
  <diagram id="ubuntu-professional-boot" name="Ubuntu Boot Process">
    <mxGraphModel dx="2084" dy="1252" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Ubuntu Linux Boot Process Flowchart" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="280" y="80" width="400" height="45" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="From system power-on to the Ubuntu login prompt&lt;div&gt;John Lester D. Matienzo&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="280" y="120" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="POWER ON&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;System receives electrical power&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="340" y="165" width="280" height="75" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="BIOS / UEFI INITIALIZATION&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;POST, hardware initialization, firmware setup&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="300" y="280" width="360" height="85" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="BOOT DEVICE DETECTION&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Firmware searches configured boot devices&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="300" y="405" width="360" height="85" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="Bootable device found?" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="375" y="530" width="210" height="115" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="BOOT LOADER — GRUB&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;GRUB loads the selected Ubuntu kernel&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="300" y="695" width="360" height="85" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="LINUX KERNEL&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Kernel initializes core hardware and memory&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="300" y="820" width="360" height="85" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="init / SYSTEMD&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;systemd becomes the first userspace process (PID 1)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="300" y="945" width="360" height="85" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="SERVICES START&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Networking, login manager, and other services start&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="300" y="1070" width="360" height="85" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="LOGIN PROMPT&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;User can log in to the Ubuntu system&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="340" y="1195" width="280" height="75" as="geometry" />
        </mxCell>
        <mxCell id="error" value="No bootable device&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Firmware reports a boot failure or tries the next boot option&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="750" y="545" width="280" height="85" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" parent="1" source="n1" target="n2" edge="1">
